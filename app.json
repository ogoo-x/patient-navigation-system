{
  "expo": {
    "name": "Bubbles",
    "slug": "Bubbles",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Onboarding Illustration 1.png",
    "scheme": "bubbles",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/Onboarding Illustration 1.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#187FF6",
        "foregroundImage": "./assets/Onboarding Illustration 1.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.poiesis.bubbles"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/Onboarding Illustration 1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Bubbles to use your location to show your position on the NAUTH campus map and guide you to a destination."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/Splash Screen Illustration.png",
          "imageWidth": 180
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/patient-navigation-system"
    }
  }
}
